# Copy this file to ".env" in the repo root and set your key.
# ".env" is gitignored — never commit real secrets.
#
# OpenAI (optional): used by gpt4o-dataset and llm-judge commands in paper_experiments.py
OPENAI_API_KEY=

# If your key starts with sk-or-v1-... it is an OpenRouter key — use:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# (Optional) OpenRouter recommends a referer URL for your app:
# OPENROUTER_HTTP_REFERER=https://github.com/yourname/deception-llms
# OPENROUTER_APP_NAME=deception-llms
#
# Override model IDs (OpenRouter often needs openai/gpt-4o style names):
# OPENAI_CHAT_MODEL=openai/gpt-4o
# OPENAI_JUDGE_MODEL=openai/gpt-4o-mini
